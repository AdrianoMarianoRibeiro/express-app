# Configure npm for production environments
# Disable strict SSL for self-signed certificates (if needed in production)
# strict-ssl=false

# Use alternative registry if needed
# registry=https://registry.npmjs.org/

# Reduce timeout issues
fetch-timeout=600000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Cache settings for better performance
cache-max=86400000
prefer-offline=true

# Skip optional dependencies to reduce build time
optional=false